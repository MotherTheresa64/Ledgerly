# Ledgerly backend development/deployment template.
# Copy to .env only if your process loads dotenv values; never commit real secrets.

SECRET_KEY=replace-with-a-long-random-value
# Optional locally. Omit to use the default SQLite database.
# DATABASE_URL=postgresql://user:password@host:5432/ledgerly

CLIENT_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_REQUIRE_VERIFIED_EMAIL=true

# Choose ONE Firebase Admin credential strategy:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
